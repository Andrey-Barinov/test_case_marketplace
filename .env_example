# Секретный ключ для шифрования (замени на свой)
SECRET_KEY = "your_very_secret_key"

# Флаг тестового режима
TESTING = False

# URL базы данных для продакшена
PROD_DATABASE_URL = "postgresql+asyncpg://user:password@db_host:5432/database_name"

# URL базы данных для Alembic (с поддержкой fallback)
ALEMBIC_DATABASE_URL = "postgresql+asyncpg://user:password@db_host:5432/database_name?async_fallback=True"

# URL брокера сообщений для Celery (RabbitMQ)
CELERY_BROKER_URL = "amqp://user:password@rabbitmq_host:5672"

# Настройки SMTP для отправки email (замени на свои или используй переменные окружения)
SMTP_SERVER = "smtp.example.com"
SMTP_PORT = 587
SMTP_USER = "your_email@example.com"
SMTP_PASSWORD = "your_email_password"

# Алгоритм шифрования для токенов (Оставь HS256, если используешь JWT)
ALGORITHM = "HS256"

# Время жизни access-токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES = 30

# Конфигурация MinIO (S3-совместимое хранилище)
MINIO_ENDPOINT = "http://minio_host:9000"
MINIO_ACCESS_KEY = "your_minio_access_key"
MINIO_SECRET_KEY = "your_minio_secret_key"
